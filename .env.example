# Copy this file to .env.local and fill in ONE key to enable the AI Coach locally.
# These are read only by the local dev server / serverless function - never by the browser.

# Free option: Google Gemini (no credit card). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pick a specific Gemini model (default: gemini-flash-latest)
GEMINI_MODEL=

# Paid option: Anthropic Claude. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: if both keys are set, choose one ("gemini" or "anthropic"). Default: anthropic.
COACH_PROVIDER=

# Optional: require this code (entered in Settings) before the coach will answer.
# Recommended for deployed apps so nobody else can spend your API quota.
COACH_ACCESS_CODE=
