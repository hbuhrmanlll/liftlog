# Copy this file to .env.local and fill in your key to enable the AI Coach locally.
# Get a key at https://console.anthropic.com/settings/keys
# This is read only by the local dev server / serverless function - never by the browser.
ANTHROPIC_API_KEY=

# Optional: require this code (entered in Settings) before the coach will answer.
# Recommended for deployed apps so nobody else can spend your API credits.
COACH_ACCESS_CODE=
